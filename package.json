{
  "name": "@lzsusc2019/skills-watch",
  "version": "0.18.0",
  "description": "DSH plugin: watch installed agent skills and flag the managed ones that have fallen behind their upstream repository.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "agent-skills",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzsusc2019/skills-watch.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
